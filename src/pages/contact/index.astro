---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with IT Dude Solutions for IT support, Microsoft 365, cloud solutions, and cybersecurity."
>
  <section class="page-head section">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk about IT.</h1>
    <p class="lead">
      Have a question or need IT support? Whether you're looking for help with Microsoft
      365, cloud solutions, cybersecurity, or general IT services, we're happy to help.
    </p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Information</p>
      <h2>Get in touch.</h2>
    </div>

    <div class="prose-stack">
      <div>
        <h3>Email</h3>
        <p>
          <a href="mailto:info@itdudesolutions.de">info@itdudesolutions.de</a>
        </p>
      </div>

      <div>
        <h3>Phone</h3>
        <p>
          <a href="tel:+491716979474">+49 1716 979474</a>
        </p>
      </div>

      <div>
        <h3>Location</h3>
        <p>Regensburg, Germany</p>
      </div>

      <div>
        <h3>Business Hours</h3>
        <p>Monday – Friday</p>
        <p>08:00 – 17:00</p>
      </div>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Response</p>
      <h2>Reliable communication.</h2>
    </div>

    <div class="prose-stack">
      <p>
        We aim to respond to all inquiries within one business day. If your request is
        urgent, please call instead of sending an email.
      </p>
    </div>
  </section>
</BaseLayout>