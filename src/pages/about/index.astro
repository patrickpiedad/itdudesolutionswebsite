---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Learn more about IT Dude Solutions and our approach to IT support."
>
  <section class="page-head section">
    <p class="eyebrow">About</p>
    <h1>Practical IT support for local businesses.</h1>
    <p class="lead">
      IT Dude Solutions helps small businesses manage their technology with clear advice,
      reliable support, and solutions that fit their needs.
    </p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Who We Are</p>
      <h2>Making IT easier to manage.</h2>
    </div>

    <div class="prose-stack">
      <p>
        We provide straightforward IT support for small businesses in Regensburg and the
        surrounding area.
      </p>

      <p>
        Our goal is to simplify technology, solve problems efficiently, and help businesses
        build reliable systems they can depend on.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Services and approach">
    <div class="about-ledger">
      <article>
        <span>01</span>
        <h3>Local Support</h3>
        <p>
          Personal IT support for businesses in Regensburg and the surrounding area.
        </p>
      </article>

      <article>
        <span>02</span>
        <h3>Clear Solutions</h3>
        <p>
          Practical recommendations explained without unnecessary technical language.
        </p>
      </article>

      <article>
        <span>03</span>
        <h3>Reliable Service</h3>
        <p>
          Responsive support focused on keeping your business secure and productive.
        </p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">Our Approach</p>
      <h2>Technology that works for your business.</h2>
    </div>

    <div class="prose-stack">
      <p>
        Every business has different needs. We focus on understanding your setup first,
        then recommending solutions that are secure, manageable, and appropriate for your
        organization.
      </p>
    </div>
  </section>
</BaseLayout>