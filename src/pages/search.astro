---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';

const bundlePath = withBase('/pagefind/');
---

<BaseLayout title="Search" description="Search for any information you're looking for!">
  <section class="page-head section">
    <p class="eyebrow">Search</p>
    <h1>Find anything you're looking for.</h1>
  </section>

  <section class="section search-section" aria-label="Site search">
    <link rel="stylesheet" href={`${bundlePath}pagefind-ui.css`} />
    <div id="search">
      <p class="search-fallback">You can search here for any information you may be looking for!</p>
      </p>
    </div>
    <script is:inline define:vars={{ bundlePath }}>
      const script = document.createElement('script');
      script.src = `${bundlePath}pagefind-ui.js`;
      script.onload = () => {
        document.querySelector('#search .search-fallback')?.remove();
        new PagefindUI({
          element: '#search',
          bundlePath,
          showImages: false,
          showSubResults: true,
          autofocus: true,
        });
      };
      document.head.append(script);
    </script>
  </section>
</BaseLayout>
